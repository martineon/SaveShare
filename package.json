{
  "name": "saveshare",
  "version": "0.3.0",
  "private": true,
  "description": "Vos mondes Valheim, toujours entre de bonnes mains.",
  "author": "SaveShare",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/martineon/SaveShare.git"
  },
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "server": "node server/index.cjs",
    "test": "node --test test/*.test.cjs",
    "test:desktop": "node test/desktop.smoke.cjs",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "js-yaml": "4.3.2"
  },
  "build": {
    "appId": "app.saveshare.desktop",
    "productName": "SaveShare",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "martineon",
        "repo": "SaveShare",
        "releaseType": "release"
      }
    ],
    "files": [
      "desktop/**/*",
      "shared/**/*",
      "ui/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "semver": "7.7.4"
  }
}
